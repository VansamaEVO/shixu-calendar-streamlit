      "dataType": {
        "type": "string",
        "specs": {
          "length": "256"
        }
      }
    },
    {
      "identifier": "resultCom",
      "name": "指令回复",
      "functionType": "st",
      "accessMode": "rw",
      "desc": "",
      "dataType": {
        "type": "string",
        "specs": {
          "length": "256"
        }
      }
    },
    {
      "identifier": "writeCom",
      "name": "指令下发",
      "functionType": "st",
      "accessMode": "rw",
      "desc": "",
      "dataType": {
        "type": "string",
        "specs": {
          "length": "256"
        }
      }
    },
    {
      "identifier": "DeviceTime",
      "name": "万年历时间",
      "functionType": "u",
      "accessMode": "rw",
      "desc": "DS1302实际时间，固定格式YYYY-MM-DD HH:mm:ss；下发时自动计算星期",
      "dataType": {
        "type": "string",
        "specs": {
          "length": "19"
        }
      }
    },
    {
      "identifier": "TemperatureLow",
      "name": "温度报警下限",
      "functionType": "u",
      "accessMode": "rw",
      "desc": "整数摄氏度；必须与TemperatureHigh一起设置，且下限小于上限；51写入EEPROM",
      "dataType": {
        "type": "int32",
        "specs": {
          "min": "0",
          "max": "99",
          "unit": "℃",
          "step": "1"
        }
      }
    },
    {
      "identifier": "TemperatureHigh",
      "name": "温度报警上限",
      "functionType": "u",
      "accessMode": "rw",
      "desc": "整数摄氏度；必须与TemperatureLow一起设置，且上限大于下限；51写入EEPROM",
      "dataType": {
        "type": "int32",
        "specs": {
          "min": "0",
          "max": "99",
          "unit": "℃",
          "step": "1"
        }
      }
    },
    {
      "identifier": "HumidityLow",
      "name": "湿度报警下限",
      "functionType": "u",
      "accessMode": "rw",
      "desc": "整数相对湿度0~100；必须与HumidityHigh一起设置，且下限小于上限；51写入EEPROM",
      "dataType": {
        "type": "int32",
        "specs": {
          "min": "0",
          "max": "100",
          "unit": "相对湿度 / %RH",
          "step": "1"
        }
      }
    },
    {
      "identifier": "HumidityHigh",
      "name": "湿度报警上限",
      "functionType": "u",
      "accessMode": "rw",
      "desc": "整数相对湿度0~100；必须与HumidityLow一起设置，且上限大于下限；51写入EEPROM",
      "dataType": {
        "type": "int32",
        "specs": {
          "min": "0",
          "max": "100",
          "unit": "相对湿度 / %RH",
          "step": "1"
        }
      }
    },
    {
      "identifier": "AlarmActive",
      "name": "温湿度越限报警",
      "functionType": "u",
      "accessMode": "r",
      "desc": "51判断有效温度或湿度任一项越限；等于上下限不报警；不是界面自行推算的报警",
      "dataType": {
        "type": "bool",
        "specs": {
          "true": "温湿度越限",
          "false": "未报警"
        }
      }
    },
    {
      "identifier": "AlarmMuted",
      "name": "临时报警消音",
      "functionType": "u",
      "accessMode": "rw",
      "desc": "true立即消音约10秒，仍越限自动再次报警；false立即恢复声音；全部有效读数恢复范围内则解除报警",
      "dataType": {
        "type": "bool",
        "specs": {
          "true": "临时消音",
          "false": "未消音"
        }
      }
    },
    {
      "identifier": "McuOnline",
      "name": "单片机通信在线",
      "functionType": "u",
      "accessMode": "r",
      "desc": "ESP在最近5秒内收到51完整有效DATA帧；与ESP自身WiFi在线状态区分",
      "dataType": {
        "type": "bool",
        "specs": {
          "true": "51在线",
          "false": "51离线或超时"
        }
      }
    },
    {
      "identifier": "ControlReady",
      "name": "远程控制就绪",
      "functionType": "u",
      "accessMode": "r",
      "desc": "51数据新鲜且支持安全接收窗口，ESP控制发送口可用；具体命令仍须51执行确认",
      "dataType": {
        "type": "bool",
        "specs": {
          "true": "可发起控制",
          "false": "暂不可控制"
        }
      }
    },
    {
      "identifier": "TemperatureValid",
      "name": "温度数据有效",
      "functionType": "u",
      "accessMode": "r",
      "desc": "51温度读取有效、通信未超时且数值在当前温度物模型范围内；无效时不上传占位温度",
      "dataType": {
        "type": "bool",
        "specs": {
          "true": "温度有效",
          "false": "温度无效"
        }
      }
    },
    {
      "identifier": "HumidityValid",
      "name": "湿度数据有效",
      "functionType": "u",
      "accessMode": "r",
      "desc": "51湿度读取有效且通信未超时；无效时不上传255占位湿度",
      "dataType": {
        "type": "bool",
        "specs": {
          "true": "湿度有效",
          "false": "湿度无效"
        }
      }
    }
  ],
  "events": [],
  "services": []
}
