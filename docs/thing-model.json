{
  "properties": [
    {
      "identifier": "CurrentTemperature",
      "name": "当前温度",
      "functionType": "u",
      "accessMode": "r",
      "desc": "51的DS18B20真实温度，经ESP8266上传，保留一位小数；报警阈值仍为整数",
      "dataType": {
        "type": "float",
        "specs": {
          "min": "-40",
          "max": "125",
          "unit": "℃",
          "step": "0.1"
        }
      }
    },
    {
      "identifier": "CurrentHumidity",
      "name": "当前湿度",
      "functionType": "u",
      "accessMode": "r",
      "desc": "ESP8266上传的环境湿度",
      "dataType": {
        "type": "int32",
        "specs": {
          "min": "0",
          "max": "100",
          "unit": "相对湿度 / %RH",
          "step": "1"
        }
      }
    },
    {
      "identifier": "alarmData",
      "name": "报警上报",
